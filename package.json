{
  "name": "tn-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first Tennessee Class D knowledge-test study app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-content.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "validate:content": "node scripts/validate-content.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "audit": "node scripts/not-implemented.mjs 'npm run audit' 'P9 (PWA) + P10 (executable sweep)' 'Lighthouse on the production build: Performance >=90, Accessibility =100, Best Practices >=95, SEO >=90, installable PWA'",
    "audit:signs": "node scripts/audit-signs.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:coverage && npm run test:e2e && npm run validate:content && npm run audit:signs && npm run size && npm run test:a11y",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
